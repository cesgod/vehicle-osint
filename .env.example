# Everything here is OPTIONAL. The app starts with no .env at all (Link mode),
# and the Settings tab writes these values for you. Copy to ".env" only if you
# prefer editing by hand.

# --- Standard mode: Google Custom Search JSON API ---------------------------
# API key:           https://console.cloud.google.com/apis/credentials
# Search engine ID:  https://programmablesearchengine.google.com  ("Search the entire web" ON)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Country bias for results (gl parameter). py = Paraguay.
CSE_COUNTRY=py

# --- Quota guards -----------------------------------------------------------
# Custom Search: 100 free queries/day (resets midnight Pacific Time); paid tier is
# USD 5 per 1,000 up to 10,000/day. The app refuses to call Google past this number.
CSE_DAILY_BUDGET=100
# Minimum seconds between Custom Search calls (API limit: 100 queries/minute).
CSE_MIN_INTERVAL_SECONDS=1.0
# Identical queries inside this window are answered from SQLite at zero quota cost.
CSE_CACHE_TTL_HOURS=24
# Cloud Vision: each image costs 2 units (TEXT_DETECTION + OBJECT_LOCALIZATION).
# First 1,000 units/month per feature are free. The app stops at this number.
VISION_MONTHLY_BUDGET=1000

# --- Advanced mode: OAuth ---------------------------------------------------
# Place client_secret.json in this folder (or upload it in the Settings tab).
# Only needed for a "Web application" OAuth client on a non-default address:
# OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Server -----------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# OPEN_BROWSER=1
# OSINT_DATA_DIR=./data
